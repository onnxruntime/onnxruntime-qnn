{
    "files": [
        {
            "aql": {
                "items.find": {
                    "repo": "${repo}",
                    "$and": [
                        {
                            "created": { "$before": "1d" }
                        },
                        {
                            "path": { "$match": "ci/*" }
                        },
                        {
                            "path": { "$nmatch": "ci/qnn-ep-test-store/*" }
                        }
                    ]
                }
            }
        }
    ]
}
