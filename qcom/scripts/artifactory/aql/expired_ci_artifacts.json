{
    "files": [
        {
            "aql": {
                "items.find": {
                    "repo": "${repo}",
                    "$and": [
                        {
                            "created": { "$before": "1d" },
                            "path": {
                                "$match": "ci/*",
                                "$nmatch": "ci/qnn-ep-test-store/*"
                            }
                        }
                    ]
                }
            }
        }
    ]
}
