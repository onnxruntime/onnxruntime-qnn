From f37dab788a72a1fa8017981e06133599ce0f19fd Mon Sep 17 00:00:00 2001
From: ORT QNN EP team <noreply@qualcomm.com>
Date: Tue, 21 Jul 2026 00:00:00 +0000
Subject: [PATCH 2/4] Allow users to specify arm64ReproDir by cmake flag

---
 cmake/arm64x.cmake | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmake/arm64x.cmake b/cmake/arm64x.cmake
index 5252063..9cd26e9 100644
--- a/cmake/arm64x.cmake
+++ b/cmake/arm64x.cmake
@@ -1,4 +1,5 @@
-set(arm64ReproDir "${CMAKE_CURRENT_SOURCE_DIR}/repros")
+set(arm64ReproDir "${CMAKE_CURRENT_SOURCE_DIR}/repros" CACHE PATH "Path to the ARM64 repro directory for ARM64X build")
+message(STATUS "Using arm64ReproDir: " ${arm64ReproDir})
 
 function(set_arm64_dependencies n)
 	set(ARM64_LIBS)
